# ===========================================
# ROCS Backend Environment Variables
# ===========================================
# Copy this file to .env and fill in your values
# All variables have safe defaults for development

# Database
DB_URL=jdbc:mysql://localhost:3306/silverline?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC&createDatabaseIfNotExist=true
DB_USERNAME=root
DB_PASSWORD=CHANGE_ME

# JWT Security (MUST change in production)
JWT_SECRET=GENERATE_A_NEW_BASE64_SECRET_HERE
JWT_EXPIRATION_MS=36000000

# Email (SMTP)
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-app-password

# Server
SERVER_PORT=8080

# Logging
LOG_FILE=logs/rocs-backend.log
JPA_SHOW_SQL=false

# Admin defaults
ROCS_ADMIN_USERNAME=admin
ROCS_ADMIN_PASSWORD=CHANGE_ME
ROCS_ADMIN_EMAIL=admin@example.com

# CORS (comma-separated origins)
ROCS_CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174

# Rate Limiting
RATE_LIMIT_RPM=60
RATE_LIMIT_LOGIN_RPM=5

# Connection Pool
HIKARI_MAX_POOL=20
HIKARI_MIN_IDLE=5
