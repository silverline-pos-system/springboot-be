# ===========================================
# ROCS Backend Environment Variables
# ===========================================
# Copy this file to .env and fill in real values.
# The application no longer ships defaults for secrets: it will FAIL TO START
# if DB_PASSWORD, JWT_SECRET, MAIL_USERNAME, MAIL_PASSWORD, ROCS_ADMIN_PASSWORD,
# or ROCS_ADMIN_EMAIL are missing. This is intentional.
#
# NOTE: Spring Boot does not auto-load .env. Provide these as real environment
# variables (IDE run config, shell export, Docker env, or a dotenv wrapper).

# Database (PostgreSQL)
DB_URL=jdbc:postgresql://localhost:5432/silverline?currentSchema=public
DB_USERNAME=postgres
DB_PASSWORD=CHANGE_ME

# JPA / schema. validate = Flyway owns the schema. Do not use 'update' in production.
JPA_DDL_AUTO=validate
JPA_SHOW_SQL=false

# JWT Security. Generate a fresh 256-bit base64 secret. Do NOT reuse any previously committed value.
JWT_SECRET=GENERATE_A_NEW_BASE64_256BIT_SECRET
JWT_EXPIRATION_MS=36000000

# Email (SMTP). The previously committed Gmail app password must be revoked in the Google account.
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your-email@example.com
MAIL_PASSWORD=your-app-password

# Server
SERVER_PORT=8080

# Logging
LOG_FILE=logs/rocs-backend.log

# Bootstrap admin. Rotate the password after first login.
ROCS_ADMIN_USERNAME=admin
ROCS_ADMIN_PASSWORD=CHANGE_ME
ROCS_ADMIN_EMAIL=admin@example.com

# Actuator exposure. In production prefer just: health
ACTUATOR_EXPOSURE=health,info,metrics

# CORS (comma-separated origins). Restrict to the real frontend origin in production.
ROCS_CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174

# Rate Limiting
RATE_LIMIT_RPM=60
RATE_LIMIT_LOGIN_RPM=5

# Connection Pool
HIKARI_MAX_POOL=20
HIKARI_MIN_IDLE=5
